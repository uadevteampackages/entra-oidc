{
    "name": "ua-dev-team-packages/entra-oidc",
    "description": "Entra OIDC package for Laravel",
    "keywords": [
        "ua-dev-team-packages",
        "entra-oidc"
    ],
    "homepage": "https://github.com/ua-dev-team-packages/entra-oidc",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Joey Stowe",
            "email": "jbstowe@ua.edu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/socialite": "^5.11",
        "socialiteproviders/microsoft-azure": "^5.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "UaDevTeamPackages\\EntraOidc\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UaDevTeamPackages\\EntraOidc\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "UaDevTeamPackages\\EntraOidc\\EntraOidcServiceProvider"
            ]
        }
    }
}